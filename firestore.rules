rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hasan.xlo101@gmail.com' &&
        request.auth.token.email_verified == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Academy Courses Catalog
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(courseId);
    }

    // User profiles & progress (Protected PII)
    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();
      allow create: if isValidId(userId) && (
        (isOwner(userId) && request.resource.data.role != 'admin') || isAdmin()
      );
      allow update: if isValidId(userId) && (
        (isOwner(userId) && request.resource.data.role == resource.data.role && request.resource.data.role != 'admin') || isAdmin()
      );
      allow delete: if isAdmin() && isValidId(userId);

      // Sub-collections: Lab Progress
      match /labProgress/{labId} {
        allow read: if (isOwner(userId) || isAdmin()) && isValidId(labId);
        allow create, update: if (isOwner(userId) || isAdmin()) && isValidId(labId);
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(labId);
      }

      // Sub-collections: Threat Scans and OSINT audit logs
      match /scans/{scanId} {
        allow read: if (isOwner(userId) || isAdmin()) && isValidId(scanId);
        allow create: if (isOwner(userId) || isAdmin()) && isValidId(scanId);
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(scanId);
      }
    }

    // Explicit deny for any document not covered by the rules above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
